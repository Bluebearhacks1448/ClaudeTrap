<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ApplicationBackgroundColor">#FAF7F3</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />
    <Color x:Key="TextFillColorPrimary">#28221E</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextFillColorPrimary}" />
    <Color x:Key="TextFillColorSecondary">#756B63</Color>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FFFCF9" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#28221E" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#B85B32" />
</ResourceDictionary>